publico Clase AppEstudiante 
   Estudiante objE = nuevo Estudiante();
    //Estudiante obj;
    estatico Archivo objArchivo = nuevo Archivo();
    estatico CRUDEstudiante crudE = nuevo CRUDEstudiante();
    publico estatico vacio principal()
       menuArchivoEstudiante();    
    FinMetodo
    publico estatico Cadena menuArchivoE() 
        retonar (" **** MENU ARCHIVO Estudiante ****\n"
                + "1. Ingresar Estudiannte\n"
                + "2. Imprimir todo el Archivo\n"
                + "3. Consultar Estudiante\n"
                + "4. Eliminar un Estudiante\n"
                + "5. actualizar un Estudiante\n"
                + "6. Cambiar nombre al archivo\n"
                + "7. Eliminar un archivo\n"
                + "8. Finalizar Menu\n");

    FinMetodo
	
    publico estatico vacio menuArchivoEstudiante() 
        entero opE, idEstudiante;
        hacer 
            opE = leerEntero(menuArchivoE());
            Segun (opE) 
                caso 1: // ingresar Estudiante a Archivo
                    Imprimir("*******************************************\n");
                    idEstudiante = leerEntero("Digite el ID del cliente a registrar: ");
                    crudE.IngresarEstudiante(objArchivo, idEstudiante);
                    romper;
                caso 2: // Imprimir Archivo
                    Imprimir("*******************************************\n");
                    Imprimir("Los Registros del Archivo Estudiante son: \n" + crudE.Mostrar(objArchivo));
                    romper;
                caso 3: //Consultar
                    Imprimir("*******************************************\n");
                    idEstudiante = leerEntero("Digite el IDEstudiante del cliente a consultar: ");
                    Imprimir("El cliente consultado es: " + crudE.Consultar(objArchivo, idEstudiante));
                    romper;
                caso 4: // Eliminar
                    idEstudiante = Validacion.leerEntero("ID a eliminar: ");
                    Imprimir(crudE.Eliminar(objArchivo, idEstudiante));
                    romper;
                caso 5: // Actualizar
                    idEstudiante = Validacion.leerEntero("ID a actualizar: ");
                    crudE.Actualizar(objArchivo, idEstudiante);
                    romper;
                caso 6:
                    Imprimir("*******************************************\n");
                    Imprimir("Ingrese el nuevo nombre del archivo: ");
                    Cadena nom = sc.nextLine();
                    objArchivo.renombrarArchivo(nom + ".txt");
                    romper;
                caso 7:
                    objArchivo.eliminaArchivo("datosEstudiante.txt");
                    romper;
            FinSegun
        mientras (opE < 7);
    FinMetodo
Finclase

