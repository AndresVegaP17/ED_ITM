public class Vuelo {
    private String codVuelo = " ";
    private String nombreAerolinea = " ";
    private double altitud = 0;
    private int cantidadCombustible = 0;

    public Vuelo() 
    {
    }

    public Vuelo(String codVuelo, String nombreAerolinea, double altitud, int cantidadCombustible) {
        this.codVuelo = codVuelo;
        this.nombreAerolinea = nombreAerolinea;
        this.altitud = altitud;
        this.cantidadCombustible = cantidadCombustible;
    }

    public void setCodVuelo(String codVuelo) {
        this.codVuelo = codVuelo;
    }

    public String getCodVuelo() {
        return codVuelo;
    }

    public void setNombreAerolinea(String nombreAerolinea) {
        this.nombreAerolinea = nombreAerolinea;
    }

    public String getNombreAerolinea() {
        return nombreAerolinea;
    }

    public void setAltitud(double altitud) {
        this.altitud = altitud;
    }

    public String getAltitud() {
        return altitud;
    }

    public void setCantidadCombustible(int cantidadCombustible) {
        this.cantidadCombustible = cantidadCombustible;
    }

    public String getAltitud() {
        return cantidadCombustible ;
    }


    public String toString() {
        return "Vuelo { codVuelo: " + codVuelo + ", nombreAerolinea: " + nombreAerolinea +
                ", altitud: " + altitud + ", cantidadCombustible: " + cantidadCombustible + " }";
    }
}
